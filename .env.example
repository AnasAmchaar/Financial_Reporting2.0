# Optional: St. Louis Fed API key for monthly Morocco CPI / YoY series
# https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

GEMINI_API_KEY=your_gemini_api_key_here

# EcoEye2 API (optional overrides; defaults match repo layout)
# ECOEYE2_DB_PATH=db/pfa.db
# ECOEYE2_RAW_DIR=data/raw
# ECOEYE2_API_KEY=change-me

# ecoeye2/web/.env.local (Vite) – same key if ECOEYE2_API_KEY is set
# VITE_ECOEYE2_API_KEY=change-me
